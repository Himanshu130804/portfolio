PORT=5000

# Keep the real MongoDB connection string ONLY in your backend environment variables.
# Never place it in frontend/.env or commit it to GitHub.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/portfolio?retryWrites=true&w=majority

ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend URLs allowed by CORS.
FRONTEND_URL=http://localhost:5173,https://your-portfolio.vercel.app
